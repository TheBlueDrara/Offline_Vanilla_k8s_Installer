Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Define control_plane VM
  config.vm.define "control_plane" do |control_plane|
    control_plane.vm.hostname = "control-plane"
    control_plane.vm.network "private_network", ip: "192.168.56.11"

    # vagrant-libvirt on Ubuntu 24.04 attaches eth1 but does not configure it.
    # This provisioner writes a netplan file so the private network IP persists.
    control_plane.vm.provision "shell", inline: <<-SHELL
      cat > /etc/netplan/99-private.yaml <<'EOF'
network:
  version: 2
  ethernets:
    eth1:
      addresses: [192.168.56.11/24]
EOF
      chmod 600 /etc/netplan/99-private.yaml
      netplan apply
    SHELL

    control_plane.vm.provider :libvirt do |libvirt|
      libvirt.memory = 2048
      libvirt.cpus = 2
    end
  end

  # Define worker VM
  config.vm.define "worker" do |worker|
    worker.vm.hostname = "worker"
    worker.vm.network "private_network", ip: "192.168.56.12"

    worker.vm.provision "shell", inline: <<-SHELL
      cat > /etc/netplan/99-private.yaml <<'EOF'
network:
  version: 2
  ethernets:
    eth1:
      addresses: [192.168.56.12/24]
EOF
      chmod 600 /etc/netplan/99-private.yaml
      netplan apply
    SHELL

    worker.vm.provider :libvirt do |libvirt|
      libvirt.memory = 2048
      libvirt.cpus = 2
    end
  end
end
